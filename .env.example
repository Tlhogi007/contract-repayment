# Application
PORT=3000
# development | test | production
NODE_ENV=development

# JWT (min 32 chars; replace before any shared/deployed environment)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# Database (SQLite for local assessment runs; schema stays Postgres-portable)
# Local: file:./dev.db — Render disk: file:/data/prod.db
DATABASE_URL="file:./dev.db"

# Observability (all optional — local clone works without them)
# OTEL_SERVICE_NAME=contract-repayment-api
# OTLP HTTP base for Datadog / Azure Monitor / AWS Distro / Grafana / Jaeger, e.g.:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_METRIC_EXPORT_INTERVAL=60000
# Local smoke (no cloud account): node scripts/mock-vendor-receivers.mjs
#   then set OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
#   and/or SENTRY_DSN=http://localpublickey@127.0.0.1:9464/1
# SENTRY_DSN=https://yoursentrydsn
# VENDOR_SMOKE_ERRORS=1  # enables GET /health/smoke-error → 500 for Sentry filter smoke
